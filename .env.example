# Clinical OS — root environment (copy to .env)
# Default path: native local PostgreSQL (Docker is optional / not required).
# See docs/LOCAL_SETUP.md

# PostgreSQL (local install)
POSTGRES_USER=clinicalos
POSTGRES_PASSWORD=clinicalos_dev
POSTGRES_DB=clinicalos
DATABASE_URL=postgresql://clinicalos:clinicalos_dev@localhost:5432/clinicalos?schema=public

# Redis — OPTIONAL (not required to run the API today; reserved for future cache/jobs)
# REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:8080

# Medicine seed (one-time / manual import size from DGDA file; 0 = skip file import)
# TODO(dgda-auto-import): replace manual seed limits with automated DGDA sync when implemented
MEDICINE_SEED_LIMIT=3000

# Panels (dev)
VITE_API_URL=http://localhost:3001
