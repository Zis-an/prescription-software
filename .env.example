# Clinical OS — root environment (copy to .env)

# PostgreSQL
POSTGRES_USER=clinicalos
POSTGRES_PASSWORD=clinicalos_dev
POSTGRES_DB=clinicalos
DATABASE_URL=postgresql://clinicalos:clinicalos_dev@localhost:5432/clinicalos?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:8080

# Medicine seed (number of DGDA rows to import; 0 = skip file import)
MEDICINE_SEED_LIMIT=3000

# Panels (dev)
VITE_API_URL=http://localhost:3001
