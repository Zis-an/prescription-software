{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "clinical-os.field-catalog",
  "version": "1.0.0",
  "title": "Unbound prescription field catalog",
  "description": "Master field list aligned to WHO Guide to Good Prescribing essentials and HL7 FHIR MedicationRequest concepts. No vendor binding. Add, remove, or rename freely.",
  "standards": {
    "who": "WHO Guide to Good Prescribing / Model Formulary prescription elements",
    "fhir": "HL7 FHIR R4/R5 MedicationRequest, Patient, Practitioner, Encounter, Dosage"
  },
  "fields": [
    { "id": "rx.id", "type": "string", "required": true, "fhir": "MedicationRequest.identifier", "who": "prescription identity", "print": true, "form": true },
    { "id": "rx.version", "type": "integer", "required": true, "fhir": "MedicationRequest.meta.versionId", "who": "amendment control", "print": true, "form": false },
    { "id": "rx.status", "type": "enum", "enum": ["draft", "signed", "superseded", "cancelled"], "required": true, "fhir": "MedicationRequest.status", "print": true, "form": false },
    { "id": "rx.authoredOn", "type": "datetime", "required": true, "fhir": "MedicationRequest.authoredOn", "who": "date", "print": true, "form": true },
    { "id": "rx.followUpDate", "type": "date", "required": false, "fhir": "Appointment / CarePlan", "who": "follow-up advice", "print": true, "form": true },
    { "id": "rx.diagnosis", "type": "string", "required": false, "fhir": "MedicationRequest.reason", "who": "diagnosis", "print": true, "form": true },
    { "id": "rx.chiefComplaint", "type": "string", "required": false, "fhir": "Encounter.reasonCode", "print": true, "form": true },
    { "id": "rx.advice", "type": "string", "required": false, "fhir": "MedicationRequest.note", "who": "instructions and warnings", "print": true, "form": true },
    { "id": "rx.adviceBn", "type": "string", "required": false, "print": true, "form": true },
    { "id": "rx.qrPayload", "type": "string", "required": false, "print": true, "form": false },
    { "id": "rx.verifyUrl", "type": "string", "required": false, "print": true, "form": false },

    { "id": "prescriber.name", "type": "string", "required": true, "fhir": "Practitioner.name", "who": "prescriber name", "print": true, "form": true },
    { "id": "prescriber.qualification", "type": "string", "required": false, "fhir": "Practitioner.qualification", "who": "qualification", "print": true, "form": true },
    { "id": "prescriber.bmdc", "type": "string", "required": true, "fhir": "Practitioner.identifier", "who": "registration number", "print": true, "form": true },
    { "id": "prescriber.phone", "type": "string", "required": false, "fhir": "Practitioner.telecom", "who": "telephone", "print": true, "form": true },
    { "id": "prescriber.signatureDataUrl", "type": "string", "required": false, "print": true, "form": false },

    { "id": "chamber.name", "type": "string", "required": true, "fhir": "Organization.name", "print": true, "form": true },
    { "id": "chamber.address", "type": "string", "required": false, "fhir": "Organization.address", "who": "prescriber address", "print": true, "form": true },
    { "id": "chamber.phone", "type": "string", "required": false, "print": true, "form": true },
    { "id": "chamber.hours", "type": "string", "required": false, "print": true, "form": true },
    { "id": "chamber.logoUrl", "type": "string", "required": false, "print": true, "form": false },
    { "id": "chamber.padAccent", "type": "string", "required": false, "print": false, "form": true },

    { "id": "patient.name", "type": "string", "required": true, "fhir": "Patient.name", "who": "patient name", "print": true, "form": true },
    { "id": "patient.ageYears", "type": "number", "required": false, "fhir": "Patient.birthDate (derived)", "who": "age", "print": true, "form": true },
    { "id": "patient.sex", "type": "enum", "enum": ["male", "female", "other", "unknown"], "required": false, "fhir": "Patient.gender", "who": "sex", "print": true, "form": true },
    { "id": "patient.weightKg", "type": "number", "required": false, "fhir": "Observation (body-weight)", "who": "weight when relevant", "print": true, "form": true },
    { "id": "patient.heightCm", "type": "number", "required": false, "fhir": "Observation (body-height)", "print": false, "form": true },
    { "id": "patient.phone", "type": "string", "required": false, "fhir": "Patient.telecom", "print": true, "form": true },
    { "id": "patient.address", "type": "string", "required": false, "fhir": "Patient.address", "who": "address", "print": false, "form": true },
    { "id": "patient.allergies", "type": "string", "required": false, "fhir": "AllergyIntolerance", "who": "allergic status", "print": true, "form": true },
    { "id": "patient.id", "type": "string", "required": false, "fhir": "Patient.identifier", "print": true, "form": true },

    { "id": "visit.serial", "type": "string", "required": false, "print": true, "form": true },
    { "id": "visit.fee", "type": "number", "required": false, "print": false, "form": true },
    { "id": "visit.vitals.bp", "type": "string", "required": false, "print": true, "form": true },
    { "id": "visit.vitals.pulse", "type": "string", "required": false, "print": true, "form": true },
    { "id": "visit.vitals.tempC", "type": "number", "required": false, "print": true, "form": true },
    { "id": "visit.vitals.spo2", "type": "number", "required": false, "print": true, "form": true },

    { "id": "med.lineNo", "type": "integer", "required": true, "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.genericName", "type": "string", "required": true, "fhir": "Medication.code", "who": "INN / generic name", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.brandName", "type": "string", "required": false, "who": "trade name if needed", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.strength", "type": "string", "required": true, "who": "strength SI units", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.form", "type": "string", "required": true, "who": "dosage form", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.route", "type": "string", "required": false, "fhir": "Dosage.route", "who": "route", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.dose", "type": "string", "required": true, "fhir": "Dosage.doseAndRate", "who": "dose", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.frequency", "type": "string", "required": true, "fhir": "Dosage.timing", "who": "frequency", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.duration", "type": "string", "required": true, "fhir": "Dosage.timing.repeat.boundsDuration", "who": "duration / quantity", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.quantity", "type": "string", "required": false, "fhir": "dispenseRequest.quantity", "who": "quantity to dispense", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.instruction", "type": "string", "required": false, "fhir": "Dosage.additionalInstruction / text", "who": "directions", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.instructionBn", "type": "string", "required": false, "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.prnMax", "type": "string", "required": false, "who": "PRN max daily / min interval", "print": true, "form": true, "repeatable": "medications" },
    { "id": "med.substitutionAllowed", "type": "boolean", "required": false, "fhir": "MedicationRequest.substitution", "print": false, "form": true, "repeatable": "medications" }
  ]
}
