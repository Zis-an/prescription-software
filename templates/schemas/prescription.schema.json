{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clinical-os.prescription.payload",
  "title": "Prescription print/form payload",
  "type": "object",
  "required": ["rx", "prescriber", "chamber", "patient", "medications"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "templateId": { "type": "string" },
        "paper": { "type": "string", "enum": ["a4", "a5"] },
        "locale": { "type": "string", "enum": ["en", "bn"] }
      }
    },
    "rx": {
      "type": "object",
      "required": ["id", "version", "status", "authoredOn"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "authoredOn": { "type": "string" },
        "followUpDate": { "type": "string" },
        "diagnosis": { "type": "string" },
        "chiefComplaint": { "type": "string" },
        "advice": { "type": "string" },
        "adviceBn": { "type": "string" },
        "qrPayload": { "type": "string" },
        "verifyUrl": { "type": "string" }
      }
    },
    "prescriber": {
      "type": "object",
      "required": ["name", "bmdc"],
      "properties": {
        "name": { "type": "string" },
        "qualification": { "type": "string" },
        "bmdc": { "type": "string" },
        "phone": { "type": "string" },
        "signatureDataUrl": { "type": "string" }
      }
    },
    "chamber": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "hours": { "type": "string" },
        "logoUrl": { "type": "string" },
        "padAccent": { "type": "string" }
      }
    },
    "patient": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ageYears": { "type": "number" },
        "sex": { "type": "string" },
        "weightKg": { "type": "number" },
        "heightCm": { "type": "number" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "allergies": { "type": "string" }
      }
    },
    "visit": {
      "type": "object",
      "properties": {
        "serial": { "type": "string" },
        "fee": { "type": "number" },
        "vitals": {
          "type": "object",
          "properties": {
            "bp": { "type": "string" },
            "pulse": { "type": "string" },
            "tempC": { "type": "number" },
            "spo2": { "type": "number" }
          }
        }
      }
    },
    "medications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lineNo", "genericName", "strength", "form", "dose", "frequency", "duration"],
        "properties": {
          "lineNo": { "type": "integer" },
          "genericName": { "type": "string" },
          "brandName": { "type": "string" },
          "strength": { "type": "string" },
          "form": { "type": "string" },
          "route": { "type": "string" },
          "dose": { "type": "string" },
          "frequency": { "type": "string" },
          "duration": { "type": "string" },
          "quantity": { "type": "string" },
          "instruction": { "type": "string" },
          "instructionBn": { "type": "string" },
          "prnMax": { "type": "string" },
          "substitutionAllowed": { "type": "boolean" }
        }
      }
    }
  }
}
