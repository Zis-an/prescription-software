{
  "name": "clinical-os-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Clinical OS desktop client — offline-first Electron shell for the doctor workbench",
  "main": "dist/main/index.js",
  "author": "Clinical OS",
  "license": "UNLICENSED",
  "productName": "Clinical OS",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "build:panels": "npm run build --prefix ../web-admin && npm run build --prefix ../web-assistant && npm run build --prefix ../web-patient && npm run build --prefix ../web-pharmacy",
    "dev": "npm run build:panels && npm run build:main && electron .",
    "dev:main": "npm run build:main && electron .",
    "dev:watch": "tsc -p tsconfig.json --watch",
    "build:main": "tsc -p tsconfig.json",
    "start": "electron .",
    "start:doctor": "cross-env CLINICAL_OS_ENTRY=doctor electron .",
    "start:remote": "cross-env CLINICAL_OS_URL=http://localhost:3000 electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack": "npm run build:panels && npm run build:main && electron-builder --dir",
    "dist": "npm run build:panels && npm run build:main && electron-builder",
    "dist:win": "npm run build:panels && npm run build:main && electron-builder --win"
  },
  "engines": {
    "node": ">=20"
  },

  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "bd.clinicalos.desktop",
    "productName": "Clinical OS",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../app-templates/frontend/clinical-os-doctor",
        "to": "ui/doctor",
        "filter": ["**/*"]
      },
      {
        "from": "../../templates",
        "to": "ui/print-templates",
        "filter": ["**/*"]
      },
      {
        "from": "../web-admin/dist",
        "to": "ui/admin",
        "filter": ["**/*"]
      },
      {
        "from": "../web-assistant/dist",
        "to": "ui/assistant",
        "filter": ["**/*"]
      },
      {
        "from": "../web-patient/dist",
        "to": "ui/patient",
        "filter": ["**/*"]
      },
      {
        "from": "../web-pharmacy/dist",
        "to": "ui/pharmacy",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "resources/icon.png",
      "artifactName": "ClinicalOS-Setup-${version}.${ext}"
    },
    "icon": "resources/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Clinical OS"
    }
  }
}
